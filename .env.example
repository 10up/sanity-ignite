MAX_STATIC_PARAMS=50 # The maximum number of static params generated for a route during build time.

# Optional — enables the AI-generated search overview (POST /api/search/overview).
# Without a key the search still works; the overview is simply skipped.
ANTHROPIC_API_KEY="<paste your Anthropic API key here>"
ANTHROPIC_SEARCH_MODEL="claude-haiku-4-5" # Override with any current Anthropic model (e.g. claude-sonnet-4-6 for higher quality).