{
  "name": "@10up/sanity-ignite",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "next:dev": "next dev --turbopack",
    "next:build": "npm run sanity:typegen && next build",
    "next:start": "next start",
    "next:debug": "NEXT_PRIVATE_DEBUG_CACHE=1 next:build && next:start",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format .",
    "format:fix": "biome format --write .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "dev": "next dev --turbopack",
    "built": "npm run next:build",
    "start": "npm run next:start",
    "sanity:typegen": "mkdir -p ./.sanity && sanity schema extract --path=.sanity/schema.json && sanity typegen generate",
    "seed:pulse": "sanity datasets import --replace scripts/pulse-seed.ndjson",
    "embeddings:projection": "node src/studio/schema/embeddings/projection.ts",
    "embeddings:enable": "sanity datasets embeddings enable --projection \"$(npm run -s embeddings:projection)\"",
    "embeddings:status": "sanity datasets embeddings status",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "prepare": "husky install"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.85",
    "@next/bundle-analyzer": "^16.2.4",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-navigation-menu": "^1.2.5",
    "@radix-ui/react-slot": "^1.1.2",
    "@sanity/assist": "^6.0.4",
    "@sanity/icons": "^3.7.4",
    "@sanity/image-url": "^2.1.1",
    "@sanity/vision": "^5.21.0",
    "ai": "^6.0.208",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.476.0",
    "next": "16.2.4",
    "next-sanity": "13.1.1",
    "nuqs": "^2.8.9",
    "radix-ui": "^1.6.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "sanity": "^5.21.0",
    "server-only": "^0.0.1",
    "sonner": "^1.7.1",
    "styled-components": "^6.4.0",
    "tailwind-merge": "^3.0.2",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.1.1",
    "@sanity/codegen": "^6.0.2",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.2.0",
    "@types/node": "^20",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.3.4",
    "groq": "^5.21.0",
    "husky": "^9.1.7",
    "jsdom": "^26.0.0",
    "lint-staged": "^15.5.0",
    "postcss": "^8",
    "tailwindcss": "^4",
    "typescript": "^5.7.3",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.0.8"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": "biome check"
  }
}
